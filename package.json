    "react-native-screens": "^4.27.0",
    "react-native-sound": "^0.13.0",
    "react-native-svg": "^15.15.5",
    "react-native-webrtc": "^124.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
